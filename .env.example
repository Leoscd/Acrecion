# --- LLM ---
OPENAI_API_KEY=sk-...

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...        # publica: va al navegador
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...     # SECRETA: solo servidor y worker

# --- Portal ---
DOMINIO=portal.tudominio.com                # Caddy emite el certificado HTTPS para este dominio
PUBLIC_URL=https://portal.tudominio.com     # destino de los enlaces de invitacion
MAX_ARCHIVO_MB=50                           # 50 = limite del plan gratuito de Supabase
WORKER_INTERVALO=10                         # segundos entre consultas a la cola
